.PHONY: test integration bench lint build docker up
test:        ; go test -race -count=1 ./...
integration: ; REDIS_ADDR=$${REDIS_ADDR:-localhost:6379} go test -race -count=1 -tags integration ./...
bench:       ; go test -run '^$$' -bench . -benchmem ./ratelimit
lint:        ; golangci-lint run ./... && golangci-lint run --build-tags integration ./...
build:       ; CGO_ENABLED=0 go build -trimpath -o bin/ratelimiterd ./cmd/ratelimiterd
docker:      ; docker build -t distributed-rate-limiter .
up:          ; docker compose up --build
